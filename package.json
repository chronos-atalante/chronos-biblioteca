{
  "name": "webtoons-biblioteca",
  "productName": "Webtoons Biblioteca",
  "version": "1.0.0",
  "description": "Biblioteca de anotação de progresso em leituras de webtoons, manhwas, manhuas, mangás e livros",
  "main": "out/main/index.js",
  "desktopName": "webtoons-biblioteca.desktop",
  "type": "commonjs",
  "keywords": [
    "webtoon",
    "manhwa",
    "manga",
    "leitura",
    "biblioteca"
  ],
  "author": "morgan",
  "homepage": "https://github.com/morgan/Webtoons-Biblioteca",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run security:audit",
    "security:audit": "bin/osv-scanner scan source --lockfile package-lock.json --config .osv-scanner.toml .",
    "dist": "electron-vite build && electron-builder --linux deb",
    "dist:dir": "electron-vite build && electron-builder --linux deb --dir",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.morgan.webtoons",
    "productName": "Webtoons Biblioteca",
    "artifactName": "webtoons-biblioteca_${version}_${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "morgan <morgan@localhost>",
      "synopsis": "Acompanhe o progresso das suas leituras: webtoons, manhwas, manhuas, mangás e livros",
      "executableName": "webtoons-biblioteca",
      "syncDesktopName": true
    },
    "deb": {
      "fpm": [
        "--after-remove=build/postrm"
      ],
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
