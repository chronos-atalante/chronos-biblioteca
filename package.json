{
  "name": "webtoons-biblioteca",
  "productName": "Webtoons Biblioteca",
  "version": "1.0.0",
  "description": "Biblioteca de anotação de progresso em leituras de webtoons, manhwas, manhuas, mangás e livros",
  "main": "out/main/index.js",
  "desktopName": "webtoons-biblioteca.desktop",
  "type": "commonjs",
  "keywords": [
    "webtoon",
    "manhwa",
    "manga",
    "leitura",
    "biblioteca"
  ],
  "author": "morgan",
  "license": "MIT",
  "homepage": "https://github.com/morgan/Webtoons-Biblioteca",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --linux deb",
    "dist:dir": "electron-vite build && electron-builder --linux deb --dir",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.morgan.webtoons",
    "productName": "Webtoons Biblioteca",
    "artifactName": "webtoons-biblioteca_${version}_${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "morgan <morgan@localhost>",
      "synopsis": "Acompanhe o progresso das suas leituras: webtoons, manhwas, manhuas, mangás e livros",
      "executableName": "webtoons-biblioteca",
      "syncDesktopName": true
    },
    "deb": {
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
