#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
  for home in /home/* /root; do
    [ -d "$home" ] || continue
    rm -rf \
      "$home/.config/Chronos-biblioteca" \
      "$home/.local/share/Chronos-biblioteca" \
      "$home/.cache/Chronos-biblioteca" \
      "$home/.local/state/Chronos-biblioteca" \
      "$home/.config/Chronos Biblioteca"
  done
fi
exit 0
