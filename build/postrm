#!/bin/sh
set -e
# after-remove custom do .deb (deb.afterRemove; electron-builder roda este
# arquivo pelo writeConfigFile, que substitui as macros de nome do executável
# e do produto nos caminhos abaixo — qualquer outra macro derruba o build, e
# as aspas simples são propositais para o shell não expandir o texto crudo).
#
# Substitui o template padrão do electron-builder, então espelha as dele:
# 1. remove o update-alternatives criado no pós-instalação;
# 2. descarrega e apaga o perfil AppArmor (sem isso a policy fica imposta no
#    kernel até o reboot e o arquivo fica para trás em /etc/apparmor.d);
# 3. apaga a ação do PolicyKit criada pelo postinst (fora do banco do dpkg);
# 4. no purge, remove os dados do usuário nos diretórios XDG que o app usa
#    (XDG, minúsculo; filesystem do Linux é case-sensitive) e o cofre em
#    /var/lib/.chronos-biblioteca (decisão de produto: purge leva junto).
# shellcheck disable=SC2016

# Delete the link to the binary
# update-alternatives --remove <name> <path>: 'path' must be the registered
# alternative binary, not the generic symlink; ver man update-alternatives.
if type update-alternatives >/dev/null 2>&1; then
  update-alternatives --remove '${executable}' '/opt/${sanitizedProductName}/${executable}'
else
  rm -f '/usr/bin/${executable}'
fi

APPARMOR_PROFILE_DEST='/etc/apparmor.d/${executable}'

# Remove and unload apparmor profile.
if [ -f "$APPARMOR_PROFILE_DEST" ]; then
  # Descarrega a profile do kernel antes de apagar o arquivo, senão a policy
  # antiga continua enforced até o reboot. O guard de chroot espelha o do
  # after-install padrão (operações vivas de AppArmor não fazem sentido em
  # chroot). https://wiki.debian.org/AppArmor/HowToUse
  if apparmor_status --enabled > /dev/null 2>&1; then
    if ! { [ -x '/usr/bin/ischroot' ] && /usr/bin/ischroot; } && hash apparmor_parser 2>/dev/null; then
      apparmor_parser --remove "$APPARMOR_PROFILE_DEST" || true
    fi
  fi
  rm -f "$APPARMOR_PROFILE_DEST"
fi

# A ação do PolicyKit é criada pelo postinst (fora do banco do dpkg): remove
# aqui para não deixar uma entrada de administração órfã no sistema.
rm -f '/usr/share/polkit-1/actions/com.chronos.biblioteca.policy'

if [ "$1" = "purge" ]; then
  for home in /home/* /root; do
    [ -d "$home" ] || continue
    rm -rf \
      "$home/.config/chronos-biblioteca" \
      "$home/.local/share/chronos-biblioteca" \
      "$home/.cache/chronos-biblioteca" \
      "$home/.local/state/chronos-biblioteca"
  done
  # Cofre de segredos em /var/lib: root 0711 + pasta do usuário 0700.
  rm -rf '/var/lib/.chronos-biblioteca'
fi
exit 0
